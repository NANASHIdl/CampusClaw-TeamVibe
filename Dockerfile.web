# 前端镜像：Node 构建 → Nginx 静态托管 + 反代 /api 与 /health。

FROM node:22-alpine AS build

WORKDIR /app

# 整体拷贝而不是分开 COPY package.json：`package-lock.json` 目前还没生成，
# `COPY package-lock.json*` 在文件缺失时会直接报 "no source files were specified"。
# 锁文件入库后可拆成两段以复用依赖层缓存。
COPY frontend/ ./
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; \
    else echo "警告：缺 package-lock.json，本次用 npm install，构建不可复现" && npm install --no-audit --no-fund; fi

# 登录页「测试账号」区。三个都默认空：正式构建不显示这一块，
# 口令也就不会出现在产物里（AGENTS.md §1.3）。本机演示由 compose 传入 build args。
ARG VITE_SHOW_DEMO_ACCOUNTS=""
ARG VITE_DEMO_TEACHER_PASSWORD=""
ARG VITE_DEMO_STUDENT_PASSWORD=""
ENV VITE_SHOW_DEMO_ACCOUNTS=$VITE_SHOW_DEMO_ACCOUNTS \
    VITE_DEMO_TEACHER_PASSWORD=$VITE_DEMO_TEACHER_PASSWORD \
    VITE_DEMO_STUDENT_PASSWORD=$VITE_DEMO_STUDENT_PASSWORD

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
