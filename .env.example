# 只写键名，不写值。真实值只存在于各人本机的 .env。
# 缺任何一项必填键，后端启动即失败（见 docs/specs/02-后端开发规范.md §7）。

# ---- 应用 ----
APP_ENV=
APP_VERSION=
APP_COMMIT=
API_PORT=
WEB_PORT=
LOG_LEVEL=
# json（默认，一行一条）/ console（本地肉眼读）
LOG_FORMAT=

# ---- 数据库 ----
# 给「宿主机直跑后端」用，所以是 localhost。
# 容器内不读这个值：docker-compose.yml 里 api / migrate 已把地址写成服务名 db。
DATABASE_URL=

# ---- 向量库 ----
# 同上，localhost 只对宿主机直跑有效；容器内由 compose 写成 http://qdrant:6333。
QDRANT_URL=
QDRANT_COLLECTION=

# ---- 会话 ----
SESSION_SECRET=
SESSION_TTL_MINUTES=
# Cookie 名。改这个不影响别的键，只影响浏览器里看到的那个名字
SESSION_COOKIE_NAME=
# 登录失败限制：连续失败 LOGIN_MAX_FAILS 次锁 LOGIN_LOCK_MINUTES 分钟
LOGIN_MAX_FAILS=
LOGIN_LOCK_MINUTES=

# ---- 模型与嵌入 ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
# 留空则使用离线确定性嵌入（无外部依赖，课程判据可离线复现）；
# 填了就走 OpenAI 兼容的 /embeddings 接口
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 嵌入维度：离线模式由它决定；接真实服务时必须与服务输出维度一致
EMBEDDING_DIM=

# ---- 检索 ----
SEARCH_VECTOR_MIN=
SEARCH_TOP_K=

# ---- 上传与切片 ----
# 落盘根目录；容器内由 compose 覆盖为 /app/uploads 并挂数据卷
UPLOAD_DIR=
UPLOAD_MAX_BYTES=
UPLOAD_MAX_FILES=
# 第 3 课范围：md,txt。PDF / Word 解析不在本课范围
UPLOAD_ALLOWED_EXT=
CHUNK_SIZE_CHARS=
CHUNK_OVERLAP_CHARS=

# ---- 出站白名单 ----
ALLOWED_OUTBOUND_HOSTS=

# ---- 预置账号（仅 dev / test）----
# 第二个班的账号由这两个邮箱派生（teacher+b@… / student+b@…），口令沿用同一个，
# 目的是让「跨班不可见」在没有第二套密钥的前提下也能当场复现
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
SEED_CLASS_B_SUFFIX=

# ---- 登录页「测试账号」区 ----
# 留空：登录页不显示测试账号（正式部署的唯一正确取值）。
# 填 true：显示 4 个种子账号，并把上面两个种子口令打进前端产物——
#   仅用于本机演示/验收，因为它与「口令不进前端」的硬约束（AGENTS.md §1.3）相反。
VITE_SHOW_DEMO_ACCOUNTS=
