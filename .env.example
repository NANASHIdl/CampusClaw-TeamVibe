# 只写键名，不写值。真实值只存在于各人本机的 .env。
# 缺任何一项必填键，后端启动即失败（见 docs/specs/02-后端开发规范.md §7）。

# ---- 应用 ----
APP_ENV=
APP_VERSION=
APP_COMMIT=
API_PORT=
WEB_PORT=
LOG_LEVEL=
# json（默认，一行一条）/ console（本地肉眼读）
LOG_FORMAT=

# ---- 数据库 ----
DATABASE_URL=

# ---- 向量库 ----
QDRANT_URL=
QDRANT_COLLECTION=

# ---- 会话 ----
SESSION_SECRET=
SESSION_TTL_MINUTES=

# ---- 模型与嵌入 ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---- 检索 ----
SEARCH_VECTOR_MIN=
SEARCH_TOP_K=

# ---- 上传与切片 ----
UPLOAD_MAX_BYTES=
UPLOAD_MAX_FILES=
UPLOAD_ALLOWED_EXT=
CHUNK_SIZE_CHARS=
CHUNK_OVERLAP_CHARS=

# ---- 出站白名单 ----
ALLOWED_OUTBOUND_HOSTS=

# ---- 预置账号（仅 dev / test）----
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
